                  Yes
                </button>
                <button type="button" class="dx-vote dx-vote-down" aria-pressed="false">
                  <svg class="dx-icon dx-icon-outline" viewBox="0 0 16 16" aria-hidden="true"><path d="M8.75 0.45C9.23 0.45 9.66 0.53 10.62 1.12C11.32 1.54 12.13 1.77 12.56 1.86C12.72 1.9 12.89 1.92 13.07 1.92H13.38C14.01 1.92 14.52 2.44 14.52 3.07V8.3C14.52 8.93 14.02 9.44 13.4 9.46C12.99 9.49 12.6 9.63 12.26 9.85C9.98 11.4 9.7 12.78 9.49 13.78C9.32 14.61 9.13 15.55 7.66 15.55C6.9 15.55 6.47 15.2 6.24 14.91C5.48 13.93 5.81 12.14 6.1 10.93C5.4 11.06 4.53 11.12 3.5 11.09C2.89 11.07 2.33 10.79 1.95 10.32C1.56 9.85 1.4 9.24 1.51 8.64L2.63 2.18C2.81 1.18 3.67 0.45 4.69 0.45L8.62 0.45C8.67 0.45 8.71 0.45 8.75 0.45L8.75 0.45ZM13.38 8.36C13.4 8.36 13.43 8.33 13.43 8.3V3.07L13.07 3.02C12.8 3.02 12.55 2.99 12.31 2.94C11.82 2.82 10.88 2.56 10.05 2.05C9.21 1.54 8.98 1.54 8.65 1.55L4.69 1.55C4.21 1.55 3.8 1.9 3.72 2.37L2.59 8.83C2.54 9.12 2.62 9.41 2.8 9.63C2.98 9.85 3.24 9.98 3.53 9.99C4.81 10.02 5.83 9.92 6.47 9.7C6.71 9.61 6.97 9.66 7.15 9.83C7.33 9.99 7.4 10.24 7.35 10.47L7.28 10.74C7.09 11.5 6.57 13.54 7.11 14.23C7.18 14.32 7.32 14.45 7.66 14.45C8.23 14.45 8.25 14.38 8.41 13.56C8.63 12.5 8.99 10.74 11.65 8.94C12.15 8.61 12.73 8.41 13.34 8.36H13.38Z"/></svg><svg class="dx-icon dx-icon-solid" viewBox="0 0 16 16" aria-hidden="true"><path d="M8.75 0.45C9.23 0.45 9.66 0.53 10.62 1.12C11.32 1.55 12.13 1.77 12.55 1.87C12.71 1.91 12.88 1.93 13.07 1.93H13.38C14.01 1.93 14.53 2.44 14.53 3.08V8.29C14.53 8.92 14.03 9.43 13.41 9.45C13 9.48 12.61 9.62 12.27 9.85C9.99 11.39 9.7 12.77 9.5 13.78C9.33 14.61 9.14 15.55 7.67 15.55C6.91 15.55 6.48 15.2 6.25 14.91C5.49 13.93 5.82 12.14 6.11 10.93C5.42 11.06 4.55 11.12 3.51 11.09C2.91 11.07 2.34 10.79 1.96 10.33C1.56 9.84 1.4 9.23 1.51 8.65L2.64 2.19C2.81 1.19 3.68 0.46 4.69 0.46H8.63C8.67 0.45 8.71 0.45 8.75 0.45Z"/></svg>
                  No
                </button>
              </div>
              <p class="dx-feedback-note" hidden>If you’d like to leave feedback, please <a href="https://my.10web.io/sign-up">sign up</a>.</p>
            </div>
            {{/if}}
          

          
            {{#if settings.show_related_articles}}
            <div class="dx-related">{{related_articles}}</div>
            {{/if}}
          
        </footer>
      </article>
    </div>
  </main>

  <aside class="dx-toc" id="dx-toc" aria-label="On this page">
