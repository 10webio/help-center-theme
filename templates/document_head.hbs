<!-- 10Web docs layout: theme + page flags before first paint -->
<script>
(function () {
  var d = document.documentElement, p = location.pathname;
  try { var t = localStorage.getItem('dx-theme'); if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t); } catch (e) {}
  if (/\/requests(\/|$)/.test(p)) d.classList.add('dx-tickets');
  if (/\/requests\/?$/.test(p) || /\/requests\/(ccd|organization)\/?$/.test(p)) d.classList.add('dx-tickets-list');
})();
</script>

