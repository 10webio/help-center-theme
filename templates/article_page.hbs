<div class="dx-shell">
  <aside class="dx-sidebar" id="dx-sidebar" aria-label="Help Center navigation">
    <nav id="dx-tree" aria-busy="true">
      <div class="dx-tree-loading" aria-hidden="true"><div class="dx-skel"></div><div class="dx-skel"></div><div class="dx-skel"></div><div class="dx-skel"></div><div class="dx-skel"></div><div class="dx-skel"></div><div class="dx-skel"></div><div class="dx-skel"></div><div class="dx-skel"></div></div>
      <span class="dx-visually-hidden">Loading navigation</span>
    </nav>
  </aside>
  <div class="dx-scrim" aria-hidden="true"></div>

  <main class="dx-main" id="dx-main" data-dx-page="article" data-article-id="{{article.id}}" data-section-id="{{section.id}}">
    <div class="dx-article-col dx-article id_{{article.id}}" id="article-container">
      <article class="article">
        <div class="dx-eyebrow-row">
          <p class="dx-eyebrow"><a href="{{section.url}}">{{section.name}}</a></p>
          <div class="dx-eyebrow-actions">
            <button class="dx-copy clipboard-link" type="button">
              <svg class="dx-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.08 3.75C2.39 3.75 2.63 3.99 2.63 4.29C2.63 4.6 2.39 4.84 2.08 4.84C1.79 4.84 1.55 5.08 1.55 5.38V13.92C1.55 14.21 1.79 14.45 2.08 14.45H10.62C10.92 14.45 11.15 14.21 11.15 13.92C11.15 13.61 11.4 13.37 11.7 13.37C12.01 13.37 12.25 13.61 12.25 13.92C12.25 14.82 11.52 15.55 10.62 15.55H2.08C1.18 15.55 0.45 14.82 0.45 13.92V5.38C0.45 4.48 1.18 3.75 2.08 3.75ZM13.92 0.45C14.82 0.45 15.55 1.18 15.55 2.09V10.62C15.55 11.52 14.82 12.25 13.92 12.25H5.38C4.48 12.25 3.75 11.52 3.75 10.62V2.09C3.75 1.18 4.48 0.45 5.38 0.45H13.92ZM5.38 1.55C5.08 1.55 4.85 1.79 4.85 2.09V10.62C4.85 10.92 5.08 11.16 5.38 11.16H13.92C14.21 11.16 14.45 10.92 14.45 10.62V2.09C14.45 1.79 14.21 1.55 13.92 1.55H5.38Z"/></svg>
              <span class="clipboard">Copy article URL</span>
            </button>
          </div>
        </div>

        <header class="article-header">
          <h1 title="{{article.title}}" class="article-title">
            {{article.title}}
            {{#if article.internal}}<span class="icon-lock" title="{{t 'internal'}}"></span>{{/if}}
          </h1>
        </header>

        <section class="article-info">
          <div class="article-content">
            <div class="article-body">{{article.body}}</div>

            {{#if attachments}}
            <div class="article-attachments">
              <ul class="attachments">
                {{#each attachments}}
                <li class="attachment-item">
                  <a href="{{url}}" target="_blank" rel="noopener">{{name}}</a>
                  <span class="attachment-meta meta-data">{{size}}</span>
                </li>
                {{/each}}
              </ul>
            </div>
            {{/if}}
          </div>
        </section>

        <footer class="dx-article-footer">
          
            {{#if signed_in}}
            <div class="dx-feedback">
              <p class="dx-feedback-q" id="dx-feedback-q">Was this article helpful?</p>
              {{#with article}}
              <div class="article-votes-controls" role="radiogroup" aria-labelledby="dx-feedback-q">
                {{vote 'up' role='radio' class='article-vote article-vote-up'}}
                {{vote 'down' role='radio' class='article-vote article-vote-down'}}
              </div>
              {{/with}}
            </div>
            {{else}}
            <div class="dx-feedback" data-anonymous>
              <p class="dx-feedback-q" id="dx-feedback-q">Was this article helpful?</p>
              <div class="dx-feedback-actions" role="group" aria-labelledby="dx-feedback-q">
                <button type="button" class="dx-vote dx-vote-up" aria-pressed="false">
