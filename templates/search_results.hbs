{{!--
  Search results with Zendesk AI search (generative search / quick answers).
  Per Zendesk's Help center templating cookbook, {{generative_answers}} sits at the top of
  <section id="main-content" class="search-results-column">, before the results heading.
  Turn it on in Knowledge admin > Settings > Search settings > Quick answers > Manage.
--}}
<div class="dx-shell dx-search-mode">
  <main class="dx-main" id="dx-main" data-dx-page="search">
    <div class="dx-sr">
      <p class="dx-eyebrow">{{#link 'help_center'}}Help Center{{/link}}</p>
      <h1 class="dx-rq-title">{{#if query}}Results for “{{query}}”{{else}}Search the Help Center{{/if}}</h1>

      <div class="dx-sr-form">
        {{search submit=false instant=settings.instant_search class='dx-sr-zd-search' placeholder='Search or ask a question…'}}
      </div>

      <section id="main-content" class="search-results-column">
        {{generative_answers}}

        <h2 class="dx-sr-count search-results-subheading">{{results_count}} results</h2>

        {{#if article_results}}
        <ul class="dx-sr-list">
          {{#each article_results}}
          <li class="dx-sr-item result-article">
            <a href="{{url}}">
              <span class="dx-sr-path">{{#each path_steps}}<span>{{name}}</span>{{/each}}</span>
              <span class="dx-sr-title">{{title}}</span>
              <span class="dx-sr-desc">{{text}}</span>
            </a>
          </li>
          {{/each}}
          {{#if help_center.community_enabled}}
          {{#each post_results}}
          <li class="dx-sr-item result-post">
            <a href="{{url}}">
              <span class="dx-sr-path">{{#each path_steps}}<span>{{name}}</span>{{/each}}</span>
              <span class="dx-sr-title">{{title}}</span>
              <span class="dx-sr-desc">{{text}}</span>
            </a>
          </li>
          {{/each}}
          {{/if}}
        </ul>
        {{pagination}}
        {{else}}
        <div class="dx-rq-empty dx-sr-empty">
          <p class="dx-rq-empty-t">No results for “{{query}}”</p>
          <p class="dx-rq-empty-d">Try fewer or different words, or ask our support team.</p>
          {{#link 'new_request' class='dx-cta dx-rq-new'}}Submit a ticket{{/link}}
        </div>
        {{/if}}
      </section>
    </div>
  </main>
</div>
<script>
  (function () {
    var items = document.querySelectorAll('.dx-sr-item');
    Array.prototype.forEach.call(items, function (li) {
      var path = li.querySelector('.dx-sr-path');
      if (path && /Archive Category/.test(path.textContent)) li.hidden = true;
    });
  })();
</script>
